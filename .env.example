# Copy to .env (git-ignored) and set at least MASTER_SECRET.

# ── Networking ───────────────────────────────────────────────────────────
BIND_HOST=127.0.0.1
ADMIN_PORT=8080
GATEWAY_HTTP_PORT=8888
GATEWAY_SOCKS_PORT=1080

# ── Exposure guards ──────────────────────────────────────────────────────
# Neither the admin UI nor the two proxy gateways authenticate callers, so
# BIND_HOST=0.0.0.0 would publish all three to your network (an open proxy).
# The loopback default below needs none of these settings. Binding anywhere
# else requires ALL THREE, deliberately:
#   1. explicit consent to expose the gateways,
#   2. a token, enforced on the admin UI and API,
#   3. the host names you will actually use, so Host validation stays strict.
ALLOW_REMOTE_BIND=false
# Required once ALLOW_REMOTE_BIND=true. Clients send it as
# `Authorization: Bearer ...`; the /login form sets an HttpOnly cookie.
# It travels in clear text over plain HTTP, so keep remote access on a
# trusted network or terminate TLS in front of the admin port.
ADMIN_TOKEN=
# Comma-separated host names or addresses, e.g. 192.168.1.50,proxy.lan
ADMIN_ALLOWED_HOSTS=

# ── Storage ──────────────────────────────────────────────────────────────
DB_PATH=./data/proxies.db

# ── Secrets ──────────────────────────────────────────────────────────────
# REQUIRED. Any strong passphrase. If you lose it, you lose your stored passwords.
MASTER_SECRET=CHANGE_ME_NOW

# ── Health check ─────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_S=300
HEALTH_TIMEOUT_S=8
HEALTH_CONCURRENCY=20
HEALTH_PROBE_URL=https://api.ipify.org?format=json

# ── Pool policy ──────────────────────────────────────────────────────────
POOL_MIN_SCORE=40
ROTATION_STRATEGY=weighted      # round_robin | random | weighted | sticky
STICKY_TTL_S=900
QUARANTINE_MINUTES=10

# ── Gateway behaviour ────────────────────────────────────────────────────
GATEWAY_TIMEOUT_S=15
MAX_RETRY_PER_REQUEST=2
BURN_INSPECT_BODY=true
# Refuse new connections beyond this many in flight, per gateway (HTTP and
# SOCKS5 counted separately). Each connection holds a task, two sockets and up
# to 1 MiB of buffered body: this is admission control, not throttling.
GATEWAY_MAX_CONNECTIONS=256

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Geolocation (opt-in, sends only exit IPs to a third-party service) ─
# Set to true to enable per-exit-IP country lookup. The provider URL below
# receives nothing but the raw exit IP (never credentials). Results are
# cached locally in the geo_cache table.
GEOLOCATION_ENABLED=false
# HTTPS by default — exit IPs are not disclosed in cleartext (audit C2).
# ipapi.co's free tier is used by default; the parser also handles
# ip-api.com's response schema if you prefer that provider with a paid key.
GEOLOCATION_PROVIDER_URL=https://ipapi.co/{ip}/json/
GEOLOCATION_CACHE_TTL_S=2592000
GEOLOCATION_TIMEOUT_S=4.0

# ── Auto-updates (git-based, see docs/UPDATES.md) ──────────────────────
# UPDATES_ENABLED=false disables the checker entirely (no HTTP to GitHub).
UPDATES_ENABLED=true
UPDATES_REPO=nik121212T/proxy-rotator
UPDATES_CHECK_INTERVAL_HOURS=24
UPDATES_TIMEOUT_S=5.0

# ── Dichvusocks SOCKS5 provider (opt-in import source) ─────────────────
# Leave DICHVUSOCKS_API_TOKEN empty to disable. Each imported sock debits
# one credit from the account (POST /api/providers/dichvusocks/import).
DICHVUSOCKS_API_TOKEN=
DICHVUSOCKS_BASE_URL=https://dichvusocks.net/api/v1
DICHVUSOCKS_IMPORT_MAX=50
DICHVUSOCKS_TIMEOUT_S=10.0

# Optional read-only GitHub token for private releases; otherwise uses gh auth login.
# UPDATES_GITHUB_TOKEN=
