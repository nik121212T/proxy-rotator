# Copy to .env (git-ignored) and set at least MASTER_SECRET.

# ── Networking ───────────────────────────────────────────────────────────
BIND_HOST=127.0.0.1
ADMIN_PORT=8080
GATEWAY_HTTP_PORT=8888
GATEWAY_SOCKS_PORT=1080

# ── Storage ──────────────────────────────────────────────────────────────
DB_PATH=./data/proxies.db

# ── Secrets ──────────────────────────────────────────────────────────────
# REQUIRED. Any strong passphrase. If you lose it, you lose your stored passwords.
MASTER_SECRET=CHANGE_ME_NOW

# ── Health check ─────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_S=300
HEALTH_TIMEOUT_S=8
HEALTH_CONCURRENCY=20
HEALTH_PROBE_URL=https://api.ipify.org?format=json

# ── Pool policy ──────────────────────────────────────────────────────────
POOL_MIN_SCORE=40
ROTATION_STRATEGY=weighted      # round_robin | random | weighted | sticky
STICKY_TTL_S=900
QUARANTINE_MINUTES=10

# ── Gateway behaviour ────────────────────────────────────────────────────
GATEWAY_TIMEOUT_S=15
MAX_RETRY_PER_REQUEST=2
BURN_INSPECT_BODY=true

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Geolocation (opt-in, sends only exit IPs to a third-party service) ─
# Set to true to enable per-exit-IP country lookup. The provider URL below
# receives nothing but the raw exit IP (never credentials). Results are
# cached locally in the geo_cache table.
GEOLOCATION_ENABLED=false
GEOLOCATION_PROVIDER_URL=http://ip-api.com/json/{ip}?fields=status,country,countryCode
GEOLOCATION_CACHE_TTL_S=2592000
GEOLOCATION_TIMEOUT_S=4.0

# ── Dichvusocks SOCKS5 provider (opt-in import source) ─────────────────
# Leave DICHVUSOCKS_API_TOKEN empty to disable. Each imported sock debits
# one credit from the account (POST /api/providers/dichvusocks/import).
DICHVUSOCKS_API_TOKEN=
DICHVUSOCKS_BASE_URL=https://dichvusocks.net/api/v1
DICHVUSOCKS_IMPORT_MAX=50
DICHVUSOCKS_TIMEOUT_S=10.0
